FROM node:22-alpine AS admin-build
WORKDIR /src/src/Web/TgTodo.Admin
COPY src/Web/TgTodo.Admin/package*.json ./
RUN npm ci
COPY src/Web/TgTodo.Admin/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
COPY --from=admin-build /src/src/Gateway/TgTodo.Bff/wwwroot/admin ./src/Gateway/TgTodo.Bff/wwwroot/admin
RUN dotnet publish src/Gateway/TgTodo.Bff/TgTodo.Bff.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "TgTodo.Bff.dll"]
